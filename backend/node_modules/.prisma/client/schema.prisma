datasource db {
  provider = "sqlite"
  url      = "file:./dev.db" // Path to your SQLite database file
}

generator client {
  provider = "prisma-client-js"
}

// Define your models here, e.g.:
model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  name     String @unique
  password String
}
