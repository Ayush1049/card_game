 datasource db {
      provider = "postgresql"
      url = "postgresql://ayushrao:qazwsx@localhost:5432/card-game" // Path to your database file
    }

generator client {
  provider = "prisma-client-js"
}

// Define your models here, e.g.:
model user {
    id    Int     @id @default(autoincrement())
    email String  @unique
    name  String  @unique
    password String 
}

model room {
  id String @unique
  username String @unique
  count_players Int 
}

model game {
  room_id String @unique
  count_players Int
  players String[]
}